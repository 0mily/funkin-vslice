import backend.lists.Character;

class CharacterList extends Character
{
	public function new()
	{
		super();
	}

	public function getCategories():Array<Dynamic>
    {
        return [none(), bfs(), gfs(), picos(), nenes(), week1(), week2(), week4(), week5(), week6(), week7(), weekend1(), specialCollab1(), /*week8(),*/ dead()];
    }

    public function none():Dynamic
    {
        return {
            category: "none",
            names: []
        };
    }

    public function bfs():Dynamic
    {
        return {
            category: "BFs",
            names: ["bf", "bf-dark", "bf-car", "bf-christmas", "bf-pixel", "bf-holding-gf"/*, "bf-bro"*/]
        };
    }

    public function gfs():Dynamic
    {
        return {
            category: "GFs",
            names: ["gf", "gf-dark", "gf-car", "gf-christmas", "gf-pixel", "gf-tankmen"/*, "gf-bro"*/]
        };
    }

    public function picos():Dynamic
    {
        return {
            category: "Picos",
            names: ["pico", "pico-dark", "pico-blazin", /*"pico-car (predict)",*/ "pico-christmas", "pico-pixel", "pico-holding-nene"]
        };
    }

    public function nenes():Dynamic
    {
        return {
            category: "Nenes",
            names: ["nene", "nene-dark", /*"nene-car",*/ "nene-christmas", "nene-pixel"]
        };
    }

    public function week1():Dynamic
    {
        return {
            category: "Week 1",
            names: ["dad"]
        };
    }

    public function week2():Dynamic
    {
        return {
            category: "Week 2",
            names: ["spooky", "spooky-dark", "monster"]
        };
    }

    public function week4():Dynamic
    {
        return {
            category: "Week 4",
            names: ["mom", "mom-car"]
        };
    }

    public function week5():Dynamic
    {
        return {
            category: "Week 5",
            names: ["parents-christmas", "monster-christmas"]
        };
    }

    public function week6():Dynamic
    {
        return {
            category: "Week 6",
            names: ["senpai", "senpai-angry", "spirit"]
        };
    }

    public function week7():Dynamic
    {
        return {
            category: "Week 7",
            names: ["tankman", "tankman-bloody", "pico-speaker", "otis-speaker"]
        };
    }

    public function weekend1():Dynamic
    {
        return {
            category: "Weekend 1",
            names: ["darnell", "darnell-blazin"]
        };
    }

    public function specialCollab1():Dynamic
    {
        return {
            category: "SP. Collab 1",
            names: ["sakura", "yunjin", "kazuha", "chaewon", "eunchae"]
        };
    }

    /*public function week8():Dynamic
    {
        return {
            category: "Week 8",
            names: ["experiment"]
        };
    }*/

    public function dead():Dynamic // this one you NEED to make it "dead" for the chart editor understands
    {
        return {
            category: "Dead",

            names: ["bf-dead", "pico-dead", "bf-pixel-dead", "pico-pixel-dead", "pico-explosion-dead", "pico-blazin-dead"]
        };
    }
}
